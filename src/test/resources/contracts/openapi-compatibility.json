    },
    "PATCH /api/items/{id}": {
      "responses": ["200", "400", "401", "403", "409", "500"],
      "request": "ItemPatchRequest",
      "security": ["csrfToken", "sessionCookie"]
    }
  },
  "schemaNames": [
    "ApiError",
    "AuthMessageResponse",
    "AppCurrentUserResponse",
    "ChangePasswordRequest",
    "ChangeUsernameRequest",
    "CurrentUserResponse",
    "HistoryActor",
    "HistoryRecord",
    "ItemCreateRequest",
    "ItemDeleteRequest",
    "ItemPatchRequest",
    "ItemResponse",
    "JsonNode",
    "LoginRequest",
    "LoginResponse",
    "PageableObject",
    "PageItemResponse",
    "PageSavedFilterDTO",
    "QueryEngineEntitiesConfig",
    "QueryEntityDefinition",
    "QueryEntitySummary",
    "QueryFieldDefinition",
    "QueryFilterRelationOption",
    "QueryFilterRequest",
    "QueryFilterRow",
    "QueryRelationOption",
    "SavedFilterDTO",
    "SortObject",
    "UsernameResponse"
  ],
  "schemas": {
    "ApiError": {
      "required": ["code", "message", "status", "timestamp"],
      "properties": ["code", "errors", "message", "status", "timestamp"]
    },
    "ItemCreateRequest": {
      "required": ["id", "name", "quantity", "status"],
      "properties": ["description", "id", "name", "quantity", "status"],
      "constraints": {
        "name.maxLength": 255,
        "description.maxLength": 2000,
        "quantity.minimum": 0,
        "status.enum": ["ACTIVE", "ARCHIVED", "DRAFT"]
      }
    },
    "ItemPatchRequest": {
      "required": ["version"],
      "properties": ["description", "name", "quantity", "status", "version"]
    },
    "ItemResponse": {
      "required": ["id", "name", "quantity", "status", "version"],
      "properties": ["description", "id", "name", "quantity", "status", "version"]
    },
    "ItemDeleteRequest": {
      "required": ["version"],
      "properties": ["version"]
    },
    "AppCurrentUserResponse": {
      "required": [],
      "properties": ["id", "role", "username"]
    },
    "LoginRequest": {
      "required": ["password", "username"],
      "properties": ["password", "username"],
      "constraints": {
        "username.maxLength": 100,
        "password.maxLength": 4096
      }
    }
  },
  "securitySchemes": {
    "csrfToken": { "type": "apiKey", "in": "header", "name": "X-XSRF-TOKEN" },
    "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "SESSION" }
  }
}
