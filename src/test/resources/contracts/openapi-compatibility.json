      "responses": ["200", "400", "401", "403", "409", "500"],
      "request": null,
      "security": ["sessionCookie"]
    },
    "POST /api/auth/login": {
      "responses": ["200", "400", "401", "403", "409", "500"],
      "request": "LoginRequest",
      "security": ["csrfToken"]
    },
    "POST /api/auth/logout": {
      "responses": ["200", "400", "401", "403", "409", "500"],
