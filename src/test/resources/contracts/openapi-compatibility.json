      "responses": ["200", "400", "401", "403", "409", "500"],
      "request": null,
      "security": ["sessionCookie"]
    },
    "GET /api/filters/default": {
      "responses": ["200", "400", "401", "403", "409", "500"],
      "request": null,
      "security": ["sessionCookie"]
    },
    "GET /api/history": {
      "responses": ["200", "400", "401", "403", "409", "500"],
      "request": null,
      "security": ["sessionCookie"]
    },
    "GET /api/queryengine/entities": {
      "responses": ["200", "400", "401", "403", "409", "500"],
