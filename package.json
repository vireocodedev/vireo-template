{
  "name": "starter-template",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/vireo-doctor.mjs",
    "doctor:json": "node scripts/vireo-doctor.mjs --json",
    "test:scripts": "node --test scripts/*.test.mjs",
    "vireo": "npx --yes --package=create-vireo@0.9.0 vireo",
    "release:policy": "node scripts/template-release-policy.mjs",
    "release:prepare": "node scripts/template-release-prepare.mjs",
    "generate:check": "corepack npm run vireo -- check",
    "codex:check": "node scripts/codex-customization-policy.mjs",
    "verify": "bash scripts/verify-template.sh"
  }
}
